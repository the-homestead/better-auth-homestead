{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@homestead-systems/ba-cfx": ["./packages/cfx/src/index.ts"],
      "@homestead-systems/ba-cfx/client": ["./packages/cfx/src/client.ts"],
      "@homestead-systems/ba-plugin-kit": ["./packages/plugin-kit/src/index.ts"],
      "@homestead-systems/ba-steam": ["./packages/steam/src/index.ts"],
      "@homestead-systems/ba-steam/client": ["./packages/steam/src/client/index.ts"],
      "@homestead-systems/ba-steam/server": ["./packages/steam/src/server/index.ts"],
      "@homestead-systems/ba-tebex": ["./packages/tebex/src/index.ts"],
      "@homestead-systems/ba-tebex/client": ["./packages/tebex/src/client/index.ts"],
      "@homestead-systems/ba-tebex/server": ["./packages/tebex/src/server/index.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"]
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/dist/**", "templates/**"]
}
