{
  "name": "@homestead-systems/ba-testbed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "dev": "bun --bun vite dev --host 127.0.0.1",
    "provider:mock": "bun test-support/provider-mocks/process.ts",
    "test": "bun run test:integration && bun run test:react",
    "test:e2e": "playwright test",
    "test:integration": "bun test tests/integration",
    "test:react": "bun test --preload ./test-support/dom.ts tests/react",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@homestead-systems/ba-cfx": "workspace:*",
    "@homestead-systems/ba-steam": "workspace:*",
    "@homestead-systems/ba-tebex": "workspace:*",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-start": "1.168.46",
    "better-auth": "1.6.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.11.2",
    "vite": "8.2.1"
  }
}
