{
  "name": "@itzdabbzz/better-auth-tebex",
  "version": "0.0.0",
  "private": true,
  "description": "A Better Auth Tebex billing and entitlement plugin from Homestead.",
  "keywords": [
    "authentication",
    "better-auth",
    "billing",
    "entitlements",
    "homestead",
    "tebex"
  ],
  "homepage": "https://github.com/the-homestead/better-auth-homestead/tree/main/packages/tebex#readme",
  "bugs": {
    "url": "https://github.com/the-homestead/better-auth-homestead/issues"
  },
  "license": "MIT",
  "author": "ItzDabbzz <itzdabbzz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-homestead/better-auth-homestead.git",
    "directory": "packages/tebex"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.json",
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { force: true, recursive: true });\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@itzdabbzz/better-auth-plugin-kit": "workspace:*"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0 <2"
  }
}
