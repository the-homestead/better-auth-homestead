{
  "name": "better-auth-homestead",
  "version": "0.0.0",
  "private": true,
  "description": "Homestead's collection of Better Auth plugins.",
  "license": "MIT",
  "author": "Homestead Systems <dabz@homestead.systems>",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --parallel --filter '*' --if-present build",
    "changeset": "changeset",
    "ci": "bun run validate",
    "clean": "bun run --parallel --filter '*' --if-present clean",
    "commitlint": "commitlint --last --verbose",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "packages:check": "bun scripts/check-packages.ts",
    "plugin:create": "bun scripts/create-plugin.ts",
    "prepare": "husky",
    "publish:manual": "bun scripts/publish.ts",
    "release": "changeset publish",
    "test": "bun test packages scripts && bun run test:integration && bun run test:react",
    "test:e2e": "bun run --cwd apps/testbed test:e2e",
    "test:integration": "bun run --cwd apps/testbed test:integration",
    "test:react": "bun run --cwd apps/testbed test:react",
    "test:all": "bun run test && bun run test:e2e",
    "testbed:dev": "bun run --cwd apps/testbed dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '@homestead/ba-testbed' typecheck",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run packages:check && bun run test:e2e",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "better-auth": "1.6.26",
    "husky": "9.1.7",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
