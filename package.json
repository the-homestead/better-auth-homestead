{
  "name": "better-auth-homestead",
  "version": "0.0.0",
  "private": true,
  "description": "Homestead's collection of Better Auth plugins.",
  "license": "MIT",
  "author": "ItzDabbzz <itzdabbzz@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --parallel --filter '*' --if-present build",
    "changeset": "changeset",
    "ci": "bun run validate",
    "clean": "bun run --parallel --filter '*' --if-present clean",
    "commitlint": "commitlint --last --verbose",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "packages:check": "bun scripts/check-packages.ts",
    "plugin:create": "bun scripts/create-plugin.ts",
    "prepare": "husky",
    "publish:manual": "bun scripts/publish.ts",
    "release": "changeset publish",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build && bun run packages:check",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "better-auth": "1.6.26",
    "husky": "9.1.7",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
